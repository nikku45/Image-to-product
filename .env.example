# ==========================================
# Image-to-Amazon.in Product Matcher Environment
# ==========================================

# Application Environment (development, testing, production)
APP_ENV=development
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Gemini Vision API Credentials
# Get key from: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Vision + JSON responses can take 30–90s under load; do not set below 60
GEMINI_TIMEOUT_SECONDS=120

# SerpApi Amazon Search Credentials
# Get key from: https://serpapi.com/
SERPAPI_API_KEY=

# Persistence Configuration (SQLite for dev, PostgreSQL for production)
# Local default. For deployment, set this to the PostgreSQL URL provided by the hosting provider.
# Example format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=sqlite:///./data/app.db

# Processing Policies & Limits
MAX_UPLOAD_SIZE_MB=10
MAX_SEARCH_QUERIES=2
MAX_CANDIDATES_PER_QUERY=10

# Security & CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend Configuration (used by Next.js client)
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
